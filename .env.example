# trading project configuration (SP-349 market-data store)
# Copy this file to .env and populate DB_PWD with the real value before running.
# Never commit .env - it contains the real Postgres password (it is gitignored).
#
# The market-data store (vpa/market_data/db.py) reads these keys from the project
# root .env. On the Pi the project lives at /usr/local/trading, so the file must be
# at /usr/local/trading/.env.

# PostgreSQL connection details.
# Shares the same my_postgres server as Betfair, but trading uses its OWN dedicated
# database: DB_NAME=market_data (NOT bf_trader). The bootstrap script
# (scripts/verify_market_data_db.py) creates the market_data database on first run
# via a maintenance connection to the 'postgres' database using these same creds.
#
# DB_HOST=my_postgres resolves via Docker DNS on the Pi and (on Windows dev) via a
# hosts-file entry mapping my_postgres -> 127.0.0.1. Same convention as Betfair.
DB_HOST=my_postgres
DB_PORT=5432
DB_NAME=market_data
DB_USER=postgres
DB_PWD=your_postgres_password_here
